onboarding = false


[theme]
name = "rose-pine"
auto_switch = true

[ui]
status_indicators = "symbols"
sidebar_width = 32
pane_borders = "auto"
show_agent_labels_on_pane_borders = true
tab_bar_position = "top"

tab_bar_right = [
  { type = "zoom" },
  { type = "hostname" },
  { type = "datetime", format = "%H:%M" },
  # { type = "text", text = "Hola" },
  # { type = "command", command = "~/.config/herdr/status.sh", interval_seconds = 5, timeout_seconds = 2 },
]
tab_bar_right_separator = " · "

[ui.sidebar.agents]
row_gap = 0
rows = [
  ["state_icon", "machine", { token = "$personal_agent_title", bold = true }, "$personal_agent_tab"],
  [{ token = "$personal_priority", bold = true, dim = false, rules = [{ equals = "↓ Low", fg = "#908caa" }, { equals = "↑ High", fg = "#eb6f92" }, { equals = "‼ Critical", fg = "#f7768e" }] }, { token = "$personal_status", bold = true, dim = false, rules = [{ equals = "▶ Working", fg = "#7aa2f7" }, { equals = "× Blocked", fg = "#f6c177" }, { equals = "◇ Review", fg = "#c4a7e7" }, { equals = "… Waiting", fg = "#9ccfd8" }, { equals = "✓ Done", fg = "#9ece6a" }] }],
  ["agent", "terminal_title_stripped"],
]

[ui.sidebar.spaces]
row_gap = 0
rows = [
  ["state_icon", "workspace"],
  ["branch", "git_status"],
]




[ui.toast]
delivery = "terminal"

[keys]
switch_tab = "prefix+1..9"
switch_workspace = "prefix+shift+1..9"
focus_agent = "prefix+alt+1..9"

[[keys.command]]
key = "prefix+p"
type = "plugin_action"
command = "ray.plugin-manager.open"
description = "open plugin manager"


[[keys.command]]
key = "prefix+space"
type = "shell"
command = "herdr plugin pane open --plugin palette --entrypoint palette"
description = "Command palette"


[[keys.command]]
key = "prefix+ctrl+k"
type = "plugin_action"
command = "herdr-bar.open"
description = "command bar"

[[keys.command]]
key = "prefix+alt+r"
type = "plugin_action"
command = "herdr-recap.open"


[[keys.command]]
key = "prefix+ctrl+d"
type = "plugin_action"
description = "open dagr pane"
# Windows preview: invoke open-dagr-windows instead
command = "herdr plugin action invoke open-dagr --plugin herdr-dagr"


[[keys.command]]
key = "prefix+m"
type = "plugin_action"
command = "osamahbeig.pane-mover.open"
description = "move this pane"



[session]
resume_agents_on_restore = true

[[keys.command]]
key = "prefix+ctrl+s"
type = "plugin_action"
command = "ntindle.herdr-resurrect.save"
description = "resurrect: save"

[[keys.command]]
key = "prefix+ctrl+r"
type = "plugin_action"
command = "ntindle.herdr-resurrect.restore"
description = "resurrect: restore"

# named spaces (below)
[[keys.command]]
key = "prefix+S"
type = "plugin_action"
command = "ntindle.herdr-resurrect.save-space"
description = "resurrect: save this space as…"

[[keys.command]]
key = "prefix+O"
type = "plugin_action"
command = "ntindle.herdr-resurrect.open-space"
description = "resurrect: open saved space…"

[[keys.command]]
key = "prefix+ctrl+o"
type = "plugin_action"
command = "personal.customizations.rename"
description = "Rename agent title or coding-agent name"

[[keys.command]]
key = "prefix+ctrl+u"
type = "plugin_action"
command = "personal.customizations.status"
description = "Set agent status and priority"
